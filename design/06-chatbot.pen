{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "chatbot-flow",
      "x": 0,
      "y": 0,
      "name": "Chatbot Diary — Desktop Overlay",
      "width": 2000,
      "fill": "#F5F5F5",
      "layout": "horizontal",
      "gap": 60,
      "padding": [40, 40],
      "children": [
        {
          "type": "frame",
          "id": "fab-screen",
          "name": "1. FAB on Page",
          "width": 580,
          "height": 500,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "fab-bg",
              "name": "page-content-dimmed",
              "width": 580,
              "height": 500,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "opacity": 0.5
            },
            {
              "type": "frame",
              "id": "fab-button",
              "name": "floating-action-button",
              "x": 500,
              "y": 420,
              "width": 56,
              "height": 56,
              "fill": "#D4613C",
              "cornerRadius": 28,
              "layout": "horizontal",
              "alignItems": "center",
              "justifyContent": "center",
              "children": [
                { "type": "text", "id": "fab-icon", "fill": "#FFFFFF", "content": "💬", "fontSize": 22 }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "chat-open-screen",
          "name": "2. Chat Panel Open",
          "width": 580,
          "height": 500,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "chat-page-bg",
              "name": "page-behind",
              "width": 580,
              "height": 500,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "opacity": 0.3
            },
            {
              "type": "frame",
              "id": "chat-panel",
              "name": "chat-side-panel",
              "x": 200,
              "y": 0,
              "width": 380,
              "height": 500,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "chat-header",
                  "name": "panel-header",
                  "width": "fill_container",
                  "height": 56,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "space-between",
                  "padding": [0, 20],
                  "children": [
                    {
                      "type": "frame",
                      "id": "chat-header-left",
                      "layout": "horizontal",
                      "gap": 10,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "chat-pet-avatar",
                          "width": 32,
                          "height": 32,
                          "fill": "#FBCFBD",
                          "cornerRadius": 8,
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "chat-pet-icon", "fill": "#D4613C", "content": "🐾", "fontSize": 16 }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "chat-header-text",
                          "layout": "vertical",
                          "gap": 0,
                          "children": [
                            { "type": "text", "id": "chat-title", "fill": "#1D1D20", "content": "Bjørn dagbok", "fontFamily": "ICA Rubrik", "fontSize": 15, "fontWeight": "700" },
                            { "type": "text", "id": "chat-subtitle", "fill": "#828386", "content": "AI-driven health diary", "fontFamily": "ICA Text Ny", "fontSize": 11, "fontWeight": "400" }
                          ]
                        }
                      ]
                    },
                    { "type": "text", "id": "chat-close", "fill": "#828386", "content": "✕", "fontFamily": "ICA Rubrik", "fontSize": 18, "fontWeight": "400" }
                  ]
                },
                { "type": "rectangle", "id": "chat-divider", "width": "fill_container", "height": 1, "fill": "#ECEDED" },
                {
                  "type": "frame",
                  "id": "chat-messages",
                  "name": "message-area",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "msg-bot-1",
                      "name": "bot-message",
                      "layout": "horizontal",
                      "gap": 8,
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "bot-avatar",
                          "width": 28,
                          "height": 28,
                          "fill": "#FBCFBD",
                          "cornerRadius": 14,
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "bot-icon", "fill": "#D4613C", "content": "🐾", "fontSize": 12 }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "bot-bubble",
                          "fill": "#F5F5F5",
                          "cornerRadius": 12,
                          "padding": [10, 14],
                          "children": [
                            { "type": "text", "id": "bot-text", "fill": "#45464B", "content": "Hej! Hur har Bjørn haft det idag?", "fontFamily": "ICA Text Ny", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 260 }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "msg-user-1",
                      "name": "user-message",
                      "layout": "horizontal",
                      "justifyContent": "flex-end",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "user-bubble",
                          "fill": "#FBCFBD",
                          "cornerRadius": 12,
                          "padding": [10, 14],
                          "children": [
                            { "type": "text", "id": "user-text", "fill": "#5E2018", "content": "Vi var på promenad i parken.\nBjørn haltade lite efteråt.", "fontFamily": "ICA Text Ny", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 240 }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "chat-input-area",
                  "name": "input-bar",
                  "width": "fill_container",
                  "height": 56,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [0, 16],
                  "gap": 8,
                  "children": [
                    {
                      "type": "frame",
                      "id": "chat-input",
                      "width": 288,
                      "height": 40,
                      "fill": "#F5F5F5",
                      "cornerRadius": 20,
                      "padding": [0, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "chat-placeholder", "fill": "#828386", "content": "Skriv om Bjørns dag...", "fontFamily": "ICA Text Ny", "fontSize": 14, "fontWeight": "400" }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "chat-send-btn",
                      "width": 40,
                      "height": 40,
                      "fill": "#D4613C",
                      "cornerRadius": 20,
                      "layout": "horizontal",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "send-icon", "fill": "#FFFFFF", "content": "→", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "700" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "chat-confirm-screen",
          "name": "3. Parsed Confirmation",
          "width": 580,
          "height": 500,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "confirm-page-bg",
              "width": 580,
              "height": 500,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "opacity": 0.3
            },
            {
              "type": "frame",
              "id": "confirm-panel",
              "name": "confirm-side-panel",
              "x": 200,
              "y": 0,
              "width": 380,
              "height": 500,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "confirm-header",
                  "width": "fill_container",
                  "height": 56,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [0, 20],
                  "gap": 10,
                  "children": [
                    {
                      "type": "frame",
                      "id": "confirm-avatar",
                      "width": 32,
                      "height": 32,
                      "fill": "#FBCFBD",
                      "cornerRadius": 8,
                      "layout": "horizontal",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "confirm-avatar-icon", "fill": "#D4613C", "content": "🐾", "fontSize": 16 }
                      ]
                    },
                    { "type": "text", "id": "confirm-title", "fill": "#1D1D20", "content": "Bjørn dagbok", "fontFamily": "ICA Rubrik", "fontSize": 15, "fontWeight": "700" }
                  ]
                },
                { "type": "rectangle", "id": "confirm-divider", "width": "fill_container", "height": 1, "fill": "#ECEDED" },
                {
                  "type": "frame",
                  "id": "confirm-messages",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "confirm-bot-msg",
                      "layout": "horizontal",
                      "gap": 8,
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "confirm-bot-avatar",
                          "width": 28,
                          "height": 28,
                          "fill": "#FBCFBD",
                          "cornerRadius": 14,
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "confirm-bot-icon", "fill": "#D4613C", "content": "🐾", "fontSize": 12 }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "confirm-bot-bubble",
                          "fill": "#F5F5F5",
                          "cornerRadius": 12,
                          "padding": [12, 14],
                          "layout": "vertical",
                          "gap": 10,
                          "children": [
                            { "type": "text", "id": "confirm-bot-intro", "fill": "#45464B", "content": "Jag har skapat en logg. Stämmer det?", "fontFamily": "ICA Text Ny", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 260 },
                            {
                              "type": "frame",
                              "id": "parsed-entry",
                              "name": "parsed-health-entry-card",
                              "width": "fill_container",
                              "fill": "#FFFFFF",
                              "cornerRadius": 8,
                              "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
                              "padding": [12, 12],
                              "layout": "vertical",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "parsed-category",
                                  "layout": "horizontal",
                                  "gap": 6,
                                  "alignItems": "center",
                                  "children": [
                                    { "type": "frame", "id": "parsed-dot", "width": 8, "height": 8, "fill": "#D4613C", "cornerRadius": 4 },
                                    { "type": "text", "id": "parsed-cat-label", "fill": "#828386", "content": "SYMPTOM", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "700" }
                                  ]
                                },
                                { "type": "text", "id": "parsed-title", "fill": "#1D1D20", "content": "Hälta efter promenad", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "700" },
                                { "type": "text", "id": "parsed-date", "fill": "#828386", "content": "6 mars 2026", "fontFamily": "ICA Text Ny", "fontSize": 12, "fontWeight": "400" },
                                { "type": "text", "id": "parsed-detail", "fill": "#45464B", "content": "Bjørn haltade efter promenad i parken.", "fontFamily": "ICA Text Ny", "fontSize": 12, "fontWeight": "400" }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "confirm-actions",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "gap": 8,
                      "padding": [0, 36],
                      "children": [
                        {
                          "type": "frame",
                          "id": "confirm-save-btn",
                          "width": 160,
                          "height": 40,
                          "fill": "#D4613C",
                          "cornerRadius": 8,
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "confirm-save-label", "fill": "#FFFFFF", "content": "Spara", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "700" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "confirm-edit-btn",
                          "width": 140,
                          "height": 40,
                          "fill": "#FFFFFF",
                          "cornerRadius": 8,
                          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "confirm-edit-label", "fill": "#45464B", "content": "Redigera", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "700" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}