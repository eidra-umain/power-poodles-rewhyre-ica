{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "chatbot-flow",
      "x": 0,
      "y": 0,
      "name": "Chatbot Diary Flow",
      "width": 1200,
      "fill": "#F5F5F5",
      "layout": "horizontal",
      "gap": 40,
      "padding": [40, 40],
      "children": [
        {
          "type": "frame",
          "id": "fab-screen",
          "name": "1. FAB on Dashboard",
          "width": 360,
          "height": 780,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "fab-bg",
              "name": "page-content-dimmed",
              "width": 360,
              "height": 780,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "opacity": 0.6
            },
            {
              "type": "frame",
              "id": "fab-button",
              "name": "fab",
              "x": 288,
              "y": 688,
              "width": 56,
              "height": 56,
              "fill": "#1E3065",
              "cornerRadius": 28,
              "layout": "horizontal",
              "alignItems": "center",
              "justifyContent": "center",
              "children": [
                { "type": "text", "id": "fab-icon", "fill": "#FFFFFF", "content": "Chat", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "600" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "chat-open-screen",
          "name": "2. Chat Panel Open",
          "width": 360,
          "height": 780,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "chat-dimmed-bg",
              "width": 360,
              "height": 120,
              "fill": "#000000",
              "opacity": 0.3,
              "cornerRadius": 16
            },
            {
              "type": "frame",
              "id": "chat-panel",
              "name": "chat-overlay",
              "x": 0,
              "y": 120,
              "width": 360,
              "height": 660,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "chat-handle",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    { "type": "frame", "id": "handle-bar", "width": 40, "height": 4, "fill": "#C5C6C7", "cornerRadius": 2 }
                  ]
                },
                {
                  "type": "frame",
                  "id": "chat-header",
                  "width": "fill_container",
                  "height": 48,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "space-between",
                  "padding": [0, 16],
                  "children": [
                    {
                      "type": "frame",
                      "id": "chat-header-left",
                      "layout": "horizontal",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        { "type": "frame", "id": "chat-pet-avatar", "width": 32, "height": 32, "fill": "#E0EDFF", "cornerRadius": 16 },
                        { "type": "text", "id": "chat-pet-label", "fill": "#1D1D20", "content": "Max dagbok", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "700" }
                      ]
                    },
                    { "type": "text", "id": "chat-close", "fill": "#828386", "content": "✕", "fontFamily": "ICA Rubrik", "fontSize": 20, "fontWeight": "400" }
                  ]
                },
                { "type": "rectangle", "id": "chat-divider", "width": "fill_container", "height": 1, "fill": "#ECEDED" },
                {
                  "type": "frame",
                  "id": "chat-messages",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "msg-bot-1",
                      "name": "bot-message",
                      "layout": "horizontal",
                      "gap": 8,
                      "children": [
                        { "type": "frame", "id": "bot-avatar", "width": 28, "height": 28, "fill": "#E0EDFF", "cornerRadius": 14 },
                        {
                          "type": "frame",
                          "id": "bot-bubble",
                          "fill": "#F5F5F5",
                          "cornerRadius": 12,
                          "padding": [10, 12],
                          "children": [
                            { "type": "text", "id": "bot-text-1", "fill": "#45464B", "content": "Hej! Hur har Max haft det idag?", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 240 }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "msg-user-1",
                      "name": "user-message",
                      "layout": "horizontal",
                      "justifyContent": "flex-end",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "user-bubble",
                          "fill": "#E0EDFF",
                          "cornerRadius": 12,
                          "padding": [10, 12],
                          "children": [
                            { "type": "text", "id": "user-text-1", "fill": "#1E3065", "content": "Vi var på promenad i parken.\nMax haltade lite efteråt.", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 220 }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "chat-input-area",
                  "width": "fill_container",
                  "height": 56,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [0, 12],
                  "gap": 8,
                  "children": [
                    {
                      "type": "frame",
                      "id": "chat-text-input",
                      "width": 280,
                      "height": 40,
                      "fill": "#F5F5F5",
                      "cornerRadius": 20,
                      "padding": [0, 16],
                      "layout": "horizontal",
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "chat-input-placeholder", "fill": "#828386", "content": "Skriv om Max dag...", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "400" }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "chat-send-btn",
                      "width": 40,
                      "height": 40,
                      "fill": "#1E3065",
                      "cornerRadius": 20,
                      "layout": "horizontal",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "send-icon", "fill": "#FFFFFF", "content": "→", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "700" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "chat-confirm-screen",
          "name": "3. Parsed Confirmation",
          "width": 360,
          "height": 780,
          "fill": "#F5F5F5",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "confirm-dimmed-bg",
              "width": 360,
              "height": 120,
              "fill": "#000000",
              "opacity": 0.3,
              "cornerRadius": 16
            },
            {
              "type": "frame",
              "id": "confirm-panel",
              "x": 0,
              "y": 120,
              "width": 360,
              "height": 660,
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "confirm-handle",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    { "type": "frame", "id": "confirm-handle-bar", "width": 40, "height": 4, "fill": "#C5C6C7", "cornerRadius": 2 }
                  ]
                },
                {
                  "type": "frame",
                  "id": "confirm-header",
                  "width": "fill_container",
                  "height": 48,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "padding": [0, 16],
                  "gap": 8,
                  "children": [
                    { "type": "frame", "id": "confirm-avatar", "width": 32, "height": 32, "fill": "#E0EDFF", "cornerRadius": 16 },
                    { "type": "text", "id": "confirm-title", "fill": "#1D1D20", "content": "Max dagbok", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "700" }
                  ]
                },
                { "type": "rectangle", "id": "confirm-divider", "width": "fill_container", "height": 1, "fill": "#ECEDED" },
                {
                  "type": "frame",
                  "id": "confirm-messages",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "confirm-bot-msg",
                      "layout": "horizontal",
                      "gap": 8,
                      "children": [
                        { "type": "frame", "id": "confirm-bot-avatar", "width": 28, "height": 28, "fill": "#E0EDFF", "cornerRadius": 14 },
                        {
                          "type": "frame",
                          "id": "confirm-bot-bubble",
                          "fill": "#F5F5F5",
                          "cornerRadius": 12,
                          "padding": [10, 12],
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            { "type": "text", "id": "confirm-bot-intro", "fill": "#45464B", "content": "Jag har skapat en logg. Stämmer det?", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "400", "textGrowth": "fixed-width", "width": 240 },
                            {
                              "type": "frame",
                              "id": "parsed-entry",
                              "name": "parsed-health-entry",
                              "width": "fill_container",
                              "fill": "#FFFFFF",
                              "cornerRadius": 8,
                              "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
                              "padding": [12, 12],
                              "layout": "vertical",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "parsed-category",
                                  "layout": "horizontal",
                                  "gap": 6,
                                  "alignItems": "center",
                                  "children": [
                                    { "type": "frame", "id": "parsed-dot", "width": 8, "height": 8, "fill": "#D4613C", "cornerRadius": 4 },
                                    { "type": "text", "id": "parsed-cat-label", "fill": "#828386", "content": "SYMPTOM", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "600" }
                                  ]
                                },
                                { "type": "text", "id": "parsed-title", "fill": "#1D1D20", "content": "Hälta efter promenad", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "600" },
                                { "type": "text", "id": "parsed-date", "fill": "#828386", "content": "6 mars 2026", "fontFamily": "ICA Rubrik", "fontSize": 12, "fontWeight": "400" },
                                { "type": "text", "id": "parsed-detail", "fill": "#45464B", "content": "Max haltade efter promenad i parken.", "fontFamily": "ICA Rubrik", "fontSize": 12, "fontWeight": "400" }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "confirm-actions",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "gap": 8,
                      "children": [
                        {
                          "type": "frame",
                          "id": "confirm-save-btn",
                          "width": 160,
                          "height": 40,
                          "fill": "#1E3065",
                          "cornerRadius": 8,
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "confirm-save-label", "fill": "#FFFFFF", "content": "Spara", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "600" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "confirm-edit-btn",
                          "width": 140,
                          "height": 40,
                          "fill": "#FFFFFF",
                          "cornerRadius": 8,
                          "stroke": { "align": "inside", "thickness": 1.5, "fill": "#1E3065" },
                          "layout": "horizontal",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "children": [
                            { "type": "text", "id": "confirm-edit-label", "fill": "#1E3065", "content": "Redigera", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "600" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}