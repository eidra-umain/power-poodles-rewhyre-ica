{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "dashboard-page",
      "x": 0,
      "y": 0,
      "name": "Home Dashboard (Desktop)",
      "width": 1200,
      "fill": "#F5F5F5",
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "header-top",
          "name": "header-top-bar",
          "width": "fill_container",
          "height": 64,
          "fill": "#FFFFFF",
          "layout": "horizontal",
          "alignItems": "center",
          "justifyContent": "space-between",
          "padding": [0, 32],
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "logo-group",
              "layout": "horizontal",
              "gap": 8,
              "alignItems": "center",
              "children": [
                { "type": "frame", "id": "logo-icon", "width": 32, "height": 32, "fill": "#D4613C", "cornerRadius": 8 },
                { "type": "text", "id": "logo-text", "fill": "#1D1D20", "content": "ICA Gaston", "fontFamily": "ICA Rubrik", "fontSize": 18, "fontWeight": "700" }
              ]
            },
            {
              "type": "frame",
              "id": "search-bar",
              "width": 360,
              "height": 36,
              "fill": "#F5F5F5",
              "cornerRadius": 18,
              "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
              "layout": "horizontal",
              "alignItems": "center",
              "padding": [0, 12],
              "gap": 8,
              "children": [
                { "type": "frame", "id": "search-icon", "width": 16, "height": 16, "fill": "#828386", "cornerRadius": 2 },
                { "type": "text", "id": "search-placeholder", "fill": "#828386", "content": "Search products, brands…", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "400" }
              ]
            },
            {
              "type": "frame",
              "id": "header-actions",
              "layout": "horizontal",
              "gap": 4,
              "children": [
                {
                  "type": "frame",
                  "id": "account-link",
                  "layout": "horizontal",
                  "gap": 6,
                  "alignItems": "center",
                  "padding": [8, 12],
                  "cornerRadius": 8,
                  "children": [
                    { "type": "frame", "id": "user-icon", "width": 18, "height": 18, "fill": "#45464B", "cornerRadius": 3 },
                    { "type": "text", "id": "account-label", "fill": "#45464B", "content": "Mitt konto", "fontFamily": "ICA Rubrik", "fontSize": 13, "fontWeight": "400" }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cart-link",
                  "layout": "horizontal",
                  "gap": 6,
                  "alignItems": "center",
                  "padding": [8, 12],
