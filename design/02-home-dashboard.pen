                    { "type": "text", "id": "hero-desc", "fill": "#FBCFBD", "content": "Royal Canin Golden Retriever Adult — nu med\nförbättrad formel för ledstöd och pälshälsa.", "fontFamily": "ICA Rubrik", "fontSize": 15, "fontWeight": "400" },
