                    { "type": "frame", "id": "cart-icon", "width": 18, "height": 18, "fill": "#45464B", "cornerRadius": 3 },
                    { "type": "text", "id": "cart-label", "fill": "#45464B", "content": "Varukorg", "fontFamily": "ICA Rubrik", "fontSize": 13, "fontWeight": "400" },
                    { "type": "frame", "id": "cart-badge", "width": 16, "height": 16, "fill": "#D4613C", "cornerRadius": 8, "layout": "horizontal", "alignItems": "center", "justifyContent": "center", "children": [
                      { "type": "text", "id": "cart-count", "fill": "#FFFFFF", "content": "2", "fontFamily": "ICA Rubrik", "fontSize": 10, "fontWeight": "700" }
                    ]}
                  ]
                }
              ]
            }
