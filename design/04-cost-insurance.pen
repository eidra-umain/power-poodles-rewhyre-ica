                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": { "align": "inside", "thickness": 2, "fill": "#1E3065" },
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "ic1-header",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "justifyContent": "space-between",
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "ic1-name", "fill": "#1D1D20", "content": "Lassie Hundförsäkring Plus", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "700" },
                        { "type": "frame", "id": "ic1-logo", "width": 40, "height": 24, "fill": "#E0EDFF", "cornerRadius": 4 }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ic1-metrics",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "ic1-premium",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic1-prem-label", "fill": "#828386", "content": "Premie/mån", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic1-prem-value", "fill": "#1D1D20", "content": "329 kr", "fontFamily": "ICA Rubrik", "fontSize": 20, "fontWeight": "700" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "ic1-deductible",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic1-ded-label", "fill": "#828386", "content": "Självrisk", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic1-ded-value", "fill": "#1D1D20", "content": "1 500 kr", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "600" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "ic1-coverage",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic1-cov-label", "fill": "#828386", "content": "Maxbelopp", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic1-cov-value", "fill": "#1D1D20", "content": "120 000 kr", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "600" }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ic1-cta",
                      "width": "fill_container",
                      "height": 40,
                      "fill": "#1E3065",
                      "cornerRadius": 8,
                      "layout": "horizontal",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "ic1-cta-label", "fill": "#FFFFFF", "content": "Teckna försäkring", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "600" }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ic-card-2",
                  "name": "insurance-card-B",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
                  "cornerRadius": 12,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
                  "layout": "vertical",
                  "padding": [16, 16],
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "ic2-header",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "justifyContent": "space-between",
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "ic2-name", "fill": "#1D1D20", "content": "Agria Bas", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "700" },
                        { "type": "frame", "id": "ic2-logo", "width": 40, "height": 24, "fill": "#E8F2E1", "cornerRadius": 4 }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ic2-metrics",
                      "width": "fill_container",
                      "layout": "horizontal",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "ic2-premium",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic2-prem-label", "fill": "#828386", "content": "Premie/mån", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic2-prem-value", "fill": "#1D1D20", "content": "289 kr", "fontFamily": "ICA Rubrik", "fontSize": 20, "fontWeight": "700" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "ic2-deductible",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic2-ded-label", "fill": "#828386", "content": "Självrisk", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic2-ded-value", "fill": "#1D1D20", "content": "2 000 kr", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "600" }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "ic2-coverage",
                          "layout": "vertical",
                          "gap": 2,
                          "children": [
                            { "type": "text", "id": "ic2-cov-label", "fill": "#828386", "content": "Maxbelopp", "fontFamily": "ICA Rubrik", "fontSize": 11, "fontWeight": "400" },
                            { "type": "text", "id": "ic2-cov-value", "fill": "#1D1D20", "content": "80 000 kr", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "600" }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "ic2-cta",
                      "width": "fill_container",
                      "height": 40,
                      "fill": "#FFFFFF",
                      "cornerRadius": 8,
                      "stroke": { "align": "inside", "thickness": 1.5, "fill": "#1E3065" },
                      "layout": "horizontal",
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "ic2-cta-label", "fill": "#1E3065", "content": "Teckna försäkring", "fontFamily": "ICA Rubrik", "fontSize": 14, "fontWeight": "600" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}