                      "justifyContent": "center",
                      "children": [
                        { "type": "text", "id": "modal-save-label", "fill": "#FFFFFF", "content": "Save Record", "fontFamily": "ICA Rubrik", "fontSize": 13, "fontWeight": "700" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}