{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "health-flow",
      "x": 0,
      "y": 0,
      "name": "Health Tracker — Desktop",
      "width": 2000,
      "fill": "#F5F5F5",
      "layout": "horizontal",
      "gap": 60,
      "padding": [40, 40],
      "children": [
        {
          "type": "frame",
          "id": "health-main-screen",
          "name": "1. Health Tracker — Main View",
          "width": 900,
          "height": 660,
          "fill": "#F5F5F5",
          "layout": "vertical",
          "cornerRadius": 16,
          "stroke": { "align": "inside", "thickness": 1, "fill": "#ECEDED" },
          "children": [
            {
              "type": "frame",
              "id": "ht-topbar",
              "name": "page-header",
              "width": "fill_container",
              "height": 64,
              "fill": "#FFFFFF",
              "layout": "horizontal",
              "alignItems": "center",
              "justifyContent": "space-between",
              "padding": [0, 28],
              "stroke": { "align": "inside", "thickness": 0 },
              "children": [
                {
                  "type": "frame",
                  "id": "ht-topbar-left",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    { "type": "text", "id": "ht-title", "fill": "#1D1D20", "content": "Health Tracker", "fontFamily": "ICA Rubrik", "fontSize": 18, "fontWeight": "700" },
                    { "type": "text", "id": "ht-subtitle", "fill": "#828386", "content": "Bjørn — Golden Retriever", "fontFamily": "ICA Text Ny", "fontSize": 13, "fontWeight": "400" }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ht-add-btn",
                  "name": "btn-add-record",
                  "height": 36,
                  "fill": "#D4613C",
                  "cornerRadius": 8,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": 6,
                  "padding": [0, 14],
                  "children": [
                    { "type": "text", "id": "ht-plus-icon", "fill": "#FFFFFF", "content": "+", "fontFamily": "ICA Rubrik", "fontSize": 16, "fontWeight": "700" },
                    { "type": "text", "id": "ht-add-label", "fill": "#FFFFFF", "content": "Add Record", "fontFamily": "ICA Rubrik", "fontSize": 13, "fontWeight": "700" }
                  ]
                }
              ]
            },
            { "type": "rectangle", "id": "ht-topbar-border", "width": "fill_container", "height": 1, "fill": "#ECEDED" },
            {
              "type": "frame",
              "id": "ht-content",
